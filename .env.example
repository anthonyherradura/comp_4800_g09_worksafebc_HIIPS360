# Copy to .env (git-ignored) and fill in. Read by `npm run api` / `npm run dev:api`.

# Local MongoDB service. Use 127.0.0.1, not localhost: Node tries IPv6 (::1) first and
# the Windows mongod only listens on IPv4. An Atlas URI can replace this later.
MONGODB_URI=mongodb://127.0.0.1:27017/hiips360

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the API listens on. vite.config.js proxies /api here.
PORT=3001
