# Copy to .env (git-ignored) and fill in. Read by `npm run api` / `npm run dev:api`.
# On a host (Railway, Vercel), set the same variables in its dashboard instead of uploading this file.

# Local MongoDB service. Use 127.0.0.1, not localhost: Node tries IPv6 (::1) first and
# the Windows mongod only listens on IPv4. On a host, use the hosted database's URI (e.g. Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/hiips360
# The API creates the collections, rules and indexes itself when it starts.
# For npm run test:db (creates and drops its own hiips360_test_* database):
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the API listens on. vite.config.js proxies /api here. Hosts set PORT themselves.
PORT=3001

# Leave unset locally. On a host it MUST be production: the API then serves the built app (dist/),
# marks the session cookie Secure, trusts the host's proxy and hides Gemini's raw error messages.
# NODE_ENV=production

# Bot check on sign-in and registration (Cloudflare Turnstile). Set both, or leave both empty to turn it off
# (the normal setting locally; npm test and npm run test:db don't need it). On a host, create a widget at
# dash.cloudflare.com > Turnstile with the site's domain and paste its two keys. To try it locally, use
# Cloudflare's test keys, which always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gemini API key for hazard suggestions (each developer uses their own)
GEMINI_API_KEY=
# Fastest and most accurate in our Nov 2026 benchmark (about 0.6 s, 24/24 correct). Gemma is Google's open model.
GEMINI_MODEL=gemma-4-26b-a4b-it
# Raced in if GEMINI_MODEL fails or is slow (>2.5 s). Leave empty to turn the fallback off.
# Every model must accept "minimal" thinking. These three do; 3.6 Flash also does but takes 3-5 s,
# and 3.7+ / 3.8 Flash had no usable free quota.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: wait this long for a slow model before starting the next (default 2500). Lower uses more quota.
# GEMINI_HEDGE_MS=2500
# Third model, started if the other two fail or are slow (another 2.5 s). Leave empty to turn it off.
GEMINI_SECOND_FALLBACK_MODEL=gemini-3.5-flash-lite